{
  "expo": {
    "name": "GymTracker",
    "slug": "gymtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand-logo.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.killan.gymtracker",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.killan.gymtracker"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080B0D"
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.killan.gymtracker.widgets",
          "groupIdentifier": "group.com.killan.gymtracker",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "GymTrackerWidget",
              "displayName": "GymTracker",
              "description": "Prochaine séance et objectif hebdomadaire",
              "ios": { "supportedFamilies": ["systemSmall", "systemMedium"] }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7e31400f-9acd-4416-92a5-11631c948045"
      }
    },
    "owner": "kaiser23"
  }
}
